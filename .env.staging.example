# Copy to .env.staging and fill in. .env.* is gitignored except this file.
# The whole of the staging day is in docs/sales/10-staging.md; this file is its § 2.
#
# NEVER paste a database password into a chat, an issue, or a commit message.
# If one has been exposed, rotate it first:
#   Supabase dashboard -> Settings -> Database -> Reset database password
#
# Deploy the schema with:
#   npm run db:migrate:staging
#
# There is deliberately no DATABASE_URL here. Only the migration runner should
# ever reach staging from a laptop; the application connects as dealerai_app
# from its own deployment, with its own secret.

ENV=staging

# The session pooler's address, as the postgres role — copied from the project's
# Connect panel, where the host and the region are spelled out. Port 5432: the
# transaction pooler (6543) cannot do what a migration needs.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
