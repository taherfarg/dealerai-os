# Copy to .env for local development:  cp .env.example .env
# Every variable here is declared in apps/api/src/dealerai/config.py.
# tests/test_config.py fails if the two drift apart.

ENV=local
LOG_LEVEL=debug

# The application role. NOBYPASSRLS on purpose — see supabase/migrations/0001_init.sql.
DATABASE_URL=postgresql://dealerai_app:dealerai_app@localhost:54332/dealerai

# Elevated connection, used only by the migration runner and test fixtures.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:54332/dealerai

DB_POOL_MIN=1
DB_POOL_MAX=10

# Gemini API key. Leave blank to run everything except the model gateway.
GOOGLE_API_KEY=

# Encryption for stored platform tokens. Newest key first, comma-separated.
# Generate:  cd apps/api && uv run python -c "from dealerai.connectors.crypto import generate_key; print(generate_key())"
CREDENTIALS_KEYS=

# Browser origins allowed to call the API, comma-separated.
WEB_ORIGINS=http://localhost:3000

# WhatsApp Cloud API (docs/sales/03-whatsapp.md). Locally any strings work: the
# simulator (npm run wa:simulate) signs with the same secret. Real values come from
# the Meta app dashboard, and the secret authenticates every webhook — treat it as one.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0

# Web Push (docs/sales/07-frontend.md § 8). `npm run vapid:keys` writes a private key
# here without printing it; without one nothing is pushed and the bell works as before.
# The subject is who a push service writes to about this sender: a real mailto: or
# https: address in production.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@dealerai.local

# Local development only: stored objects go to this folder instead of Supabase
# Storage. The API refuses it outside ENV=local.
STORAGE_DIR=.storage

# Your Supabase project. Leave blank until you have one.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# NOTE: there is deliberately no SUPABASE_SERVICE_ROLE_KEY here. It bypasses RLS.

# Supabase Auth's HS256 signing secret. The value below is the Supabase CLI's
# well-known local default — replace it with the real project secret anywhere
# that is not a laptop.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
